# OpenAI API key. Get one at https://platform.openai.com/api-keys
# Never expose this to the client — it is only read inside app/api/generate/route.ts.
OPENAI_API_KEY=

# --- Image generation config (all optional, see src/lib/generationConfig.ts) ---
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_INPUT_FIDELITY=high
# OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
# OPENAI_IMAGE_OUTPUT_COMPRESSION=82

# --- API protection (all optional, see src/lib/rateLimit.ts) ---
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_MS=600000
# GENERATION_COOLDOWN_MS=5000
# GLOBAL_GENERATION_LIMIT=0
# MAX_UPLOAD_BYTES=8388608
# GENERATION_TIMEOUT_MS=60000
# GENERATION_CACHE_TTL_MS=600000
